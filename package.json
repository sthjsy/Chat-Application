{
  "homepage": "./",
  "name": "chat-application",
  "version": "1.0.0",
  "description": "Chat Application",
  "author": "Your Name",
  "private": true,
  "main": "electron/main.js",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@reduxjs/toolkit": "^2.6.1",
    "@stomp/stompjs": "^7.1.0",
    "antd": "^5.24.3",
    "axios": "^1.16.0",
    "bootstrap": "^5.3.3",
    "date-fns": "^2.30.0",
    "emoji-picker-react": "^4.12.2",
    "formik": "^2.4.5",
    "hark": "^1.2.3",
    "lucide-react": "^0.481.0",
    "mediasoup-client": "^3.9.2",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.2",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.6.0",
    "react-icons": "^5.0.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.0",
    "react-toastify": "^9.1.3",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.1",
    "sockjs-client": "^1.6.1",
    "styled-components": "^6.1.15",
    "uuid": "^12.0.1",
    "web-vitals": "^3.5.2",
    "yup": "^1.3.0",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^26.6.10",
    "electron-builder": "^24.13.3",
    "react-scripts": "5.0.1",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://192.168.1.111:3000 && electron .\"",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.chat.application",
    "productName": "Chat Application",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.png"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
